{
  "name": "telegram",
  "version": "2.32.5",
  "description": "NodeJS/Browser MTProto API Telegram client library,",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "types": "./dist/client/index.d.ts",
      "require": "./dist/client/index.js",
      "import": "./dist/client/index.js"
    },
    "./errors": {
      "types": "./dist/errors/index.d.ts",
      "require": "./dist/errors/index.js",
      "import": "./dist/errors/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "require": "./dist/events/index.js",
      "import": "./dist/events/index.js"
    },
    "./extensions": {
      "types": "./dist/extensions/index.d.ts",
      "require": "./dist/extensions/index.js",
      "import": "./dist/extensions/index.js"
    },
    "./network": {
      "types": "./dist/network/index.d.ts",
      "require": "./dist/network/index.js",
      "import": "./dist/network/index.js"
    },
    "./network/connection": {
      "types": "./dist/network/connection/index.d.ts",
      "require": "./dist/network/connection/index.js",
      "import": "./dist/network/connection/index.js"
    },
    "./sessions": {
      "types": "./dist/sessions/index.d.ts",
      "require": "./dist/sessions/index.js",
      "import": "./dist/sessions/index.js"
    },
    "./tl": {
      "types": "./dist/tl/index.d.ts",
      "require": "./dist/tl/index.js",
      "import": "./dist/tl/index.js"
    },
    "./tl/core": {
      "types": "./dist/tl/core/index.d.ts",
      "require": "./dist/tl/core/index.js",
      "import": "./dist/tl/core/index.js"
    },
    "./tl/custom": {
      "types": "./dist/tl/custom/index.d.ts",
      "require": "./dist/tl/custom/index.js",
      "import": "./dist/tl/custom/index.js"
    },
    "./tl/patched": {
      "types": "./dist/tl/patched/index.d.ts",
      "require": "./dist/tl/patched/index.js",
      "import": "./dist/tl/patched/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "require": "./dist/*.js",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "build:check": "node scripts/build.js --check",
    "build:browser": "node scripts/build-browser.js",
    "codegen": "node scripts/codegen.js",
    "codegen:check": "node scripts/codegen.js --check",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.js",
    "verify": "npm run build:check && npm test",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sofwar/gramjs.git"
  },
  "browser": {
    "fs": false
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sofwar/gramjs/issues"
  },
  "keywords": [
    "telegram",
    "mtproto",
    "userbot",
    "api"
  ],
  "homepage": "https://github.com/sofwar/gramjs#readme",
  "optionalDependencies": {
    "bufferutil": "^4.0.3",
    "utf-8-validate": "^5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.12.13",
    "@babel/plugin-proposal-class-properties": "^7.12.13",
    "@babel/preset-env": "^7.12.16",
    "@types/jest": "^29.5.1",
    "@types/mime": "^2.0.3",
    "@types/node": "^15.12.0",
    "@types/node-localstorage": "^1.3.0",
    "@types/pako": "^1.0.1",
    "@types/websocket": "^1.0.4",
    "babel-loader": "^8.2.2",
    "jest": "^29.5.0",
    "os-browserify": "^0.3.0",
    "prettier": "2.3.1",
    "process": "^0.11.10",
    "ts-jest": "^29.1.0",
    "ts-loader": "^8.0.16",
    "ts-node": "^9.1.1",
    "typedoc": "^0.28.15",
    "typedoc-plugin-missing-exports": "^4.1.2",
    "typescript": "^5.9.3",
    "util": "^0.12.4",
    "webpack": "^5.69.0",
    "webpack-cli": "^4.9.2"
  },
  "dependencies": {
    "@cryptography/aes": "^0.1.1",
    "async-mutex": "^0.3.0",
    "big-integer": "^1.6.48",
    "buffer": "^6.0.3",
    "htmlparser2": "^6.1.0",
    "mime": "^3.0.0",
    "node-localstorage": "^3.0.5",
    "pako": "^2.0.3",
    "path-browserify": "^1.0.1",
    "real-cancellable-promise": "^1.1.1",
    "socks": "^2.8.7",
    "store2": "^2.13.0",
    "ts-custom-error": "^3.2.0",
    "websocket": "^1.0.34"
  }
}
